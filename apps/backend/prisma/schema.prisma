generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Player {
  id          Int      @id @default(autoincrement())
  movement    Int
  name        String
  color       String
  lobbyId     Int?
  shipId      Int?     @unique
  storageId   Int?     @unique
  turnOrder   Int
  isDead      Boolean  @default(false)
  initialHelp Boolean  @default(true)
  cleanedUp   Boolean  @default(false)
  cards       Card[]
  game        Game?
  lobby       Lobby?   @relation(fields: [lobbyId], references: [id])
  ship        Ship?    @relation(fields: [shipId], references: [id])
  storage     Storage? @relation(fields: [storageId], references: [id])

  @@unique([name, lobbyId])
  @@unique([color, lobbyId])
}

model Ship {
  id             Int     @id @default(autoincrement())
  shield         Int     @default(10)
  drill          Int     @default(10)
  engine         Int     @default(3)
  positionX      Int     @default(0)
  positionY      Int     @default(0)
  externalId     String
  engineUpgraded Boolean @default(false)
  canDrillDeeper Boolean @default(false)
  player         Player?

  @@unique([externalId, id])
}

model Storage {
  id     Int     @id @default(autoincrement())
  green  Int     @default(0)
  red    Int     @default(0)
  yellow Int     @default(0)
  player Player?
}

model Card {
  id           Int      @id @default(autoincrement())
  playerId     Int?
  storeId      Int?
  cost         Int
  type         CardType
  inFrontStore Boolean  @default(false)
  isDiscarded  Boolean  @default(false)
  player       Player?  @relation(fields: [playerId], references: [id])
  store        Store?   @relation(fields: [storeId], references: [id])
}

model Store {
  id       Int    @id @default(autoincrement())
  numCards Int    @default(18)
  cards    Card[]
  game     Game?
}

model Tile {
  id                Int      @id @default(autoincrement())
  type              TileType
  positionX         Int
  positionY         Int
  gameId            Int?
  externalId        String
  drillAttempts     Int
  ocupiedByPlayerId Int?
  game              Game?    @relation(fields: [gameId], references: [id])

  @@unique([externalId, gameId])
  @@unique([positionX, positionY, gameId])
}

model Lobby {
  id         Int       @id @default(autoincrement())
  dificulty  Dificulty
  numPlayers Int
  game       Game?
  players    Player[]
}

model Game {
  id             Int         @id @default(autoincrement())
  lobbyId        Int         @unique
  round          Int         @default(0)
  actualPlayerId Int         @unique
  supernovaLvL   Int         @default(0)
  storeId        Int?        @unique
  drillCards     DrillCard[]
  actualPlayer   Player      @relation(fields: [actualPlayerId], references: [id])
  lobby          Lobby       @relation(fields: [lobbyId], references: [id])
  store          Store?      @relation(fields: [storeId], references: [id])
  tiles          Tile[]
}

model DrillCard {
  id              Int     @id @default(autoincrement())
  greenResources  Int     @default(0)
  redResources    Int     @default(0)
  yellowResources Int     @default(0)
  isSupernovaCard Boolean @default(false)
  gameId          Int?
  game            Game?   @relation(fields: [gameId], references: [id])
}

model User {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
}

enum CardType {
  TEMPORARY_PATCH
  NEW_DRILL
  BACKUP_POWER
  SLINGSHOT
  ENHANCED_SCANNER
  ROCKET_THRUSTERS
}

enum TileType {
  EMPTY
  GREEN
  RED
  YELLOW
  SPACE_STATION
  START
}

enum Dificulty {
  BEGINNER_I
  BEGINNER_II
  EASY_I
  EASY_II
  MEDIUM_I
  MEDIUM_II
  HARD_I
  HARD_II
  EXTREME_I
  EXTREME_II
  IMPOSSIBLE
}
